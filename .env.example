# Copy to .env.local for local development. On Vercel, set the same names under
# Project → Settings → Environment Variables (Production and Preview).

# Required. Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Defaults: https://btechi.in, btechi.atechnerd@gmail.com, launch sections only.
# NEXT_PUBLIC_SITE_URL=
# NEXT_PUBLIC_CONTACT_EMAIL=
# NEXT_PUBLIC_SECTIONS=notes,videos   # or "all"

# Local only, for npm run seed:papers. Never add it to Vercel or prefix it with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
